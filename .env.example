# Скопируйте в .env. Пустые параметры включают ограниченный локальный разбор.
LLM_API_KEY=
LLM_MODEL=
# HTTPS-адрес совместимого API, включая его базовый путь, например /v1.
# Клиент добавляет к нему /chat/completions. Конкретный адрес задаёт разработчик.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=
# Необязательно: другой путь локальной базы.
# WINE_DB_PATH=data/catalog.sqlite3
